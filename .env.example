# AI Idea Authenticity & Innovation Platform - Environment Configuration Template
# Copy this file to .env or .env.local for local overrides. Never commit actual secrets!

# External AI Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
HF_API_KEY=your_huggingface_api_key_here
GITHUB_API_KEY=your_github_token_here
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Backend & API Configuration
APP_NAME="AI Idea Authenticity & Innovation Platform API"
APP_ENV=development
DEBUG=true
PORT=8000
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idea_platform

# JWT Security
JWT_SECRET_KEY=change-this-secret-in-production-use-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models & Vector Index Paths
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=backend/storage/faiss/idea_index.faiss
FAISS_METADATA_PATH=backend/storage/faiss/idea_index_meta.json
CERTIFICATE_OUTPUT_DIR=backend/storage/certificates
DATASET_PATH=backend/dataset/ideas.json

# External Research Endpoints
USPTO_API=https://api.uspto.gov/api/v1/patent/applications/search
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
ARXIV_API=https://export.arxiv.org/api/query
