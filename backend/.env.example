APP_NAME=AI Idea Authenticity & Innovation Platform API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idea_platform
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
FAISS_INDEX_PATH=backend/storage/faiss/idea_index.faiss
FAISS_METADATA_PATH=backend/storage/faiss/idea_index_meta.json
CERTIFICATE_OUTPUT_DIR=backend/storage/certificates
DATASET_PATH=backend/dataset/ideas.json
